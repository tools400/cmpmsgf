      *===============================================================*
      *  QMHRTVM API - RTVM0300                                       *
      * ============================================================= *
      *   >>PRE-COMPILER<<                                            *
      *                                                               *
      *     >>CRTCMD<<  CRTPF         FILE(&LI/&OB) +                 *
      *                               SRCFILE(&SL/&SF)  +             *
      *                               SRCMBR(&SM);                    *
      *                                                               *
      *     >>COMPILE<<                                               *
      *       >>PARM<<                MAXMBRS(1);                     *
      *       >>PARM<<                MBR(*FILE);                     *
      *       >>PARM<<                FILETYPE(*DATA);                *
      *                                                               *
      *     >>END-COMPILE<<                                           *
      *                                                               *
      *     >>EXECUTE<<                                               *
      *                                                               *
      *   >>END-PRE-COMPILER<<                                        *
      *===============================================================*
      *
      ***
      *
     A          R RTVM0300                  TEXT('QMHRTVM API - RTVM0300')
      *
     A            BYTRET         9B 0       TEXT('Bytes Returned              ')
     A            BYTAVL         9B 0       TEXT('Bytes Available             ')
     A            MSGSEV         9B 0       TEXT('Message Severity            ')
     A            ALTIDX         9B 0       TEXT('Alert Index                 ')
     A            ALTOPT         9A         TEXT('Alert Option                ')
     A            LOGIND         1A         TEXT('Log Indicator               ')
     A            MSGID          7A         TEXT('Message ID                  ')
     A            RES_01         3A         TEXT('Reserved                    ')
     A            NUMVARFMT      9B 0       TEXT('Nbr. of subst. var. formats ')
     A            CSINDTXT       9B 0       TEXT('CCSID conv. stat. ind. text ')
     A            CSINDDTA       9B 0       TEXT('CCSID conv. stat. ind. data ')
     A            CCSIDTXT       9B 0       TEXT('CCSID of Text returned      ')
     A            OFSDFTR        9B 0       TEXT('Offset of default reply     ')
     A            LENDFTRPYR     9B 0       TEXT('Length of default reply ret.')
     A            LENDFTRPYA     9B 0       TEXT('Length of default reply avl.')
     A            OFSMSG         9B 0       TEXT('Offset of message           ')
     A            LENMSGR        9B 0       TEXT('Length of message returned  ')
     A            LENMSGA        9B 0       TEXT('Length of message available ')
     A            OFSMSGHLP      9B 0       TEXT('Offset of message           ')
     A            LENMSGHLPR     9B 0       TEXT('Length of message help ret. ')
     A            LENMSGHLPA     9B 0       TEXT('Length of message help avl. ')
     A            OFSVARFMT      9B 0       TEXT('Ofs. of subst. var. formats ')
     A            LENVARFMTR     9B 0       TEXT('Length subst. var. fmt. ret.')
     A            LENVARFMTA     9B 0       TEXT('Length subst. var. fmt. avl.')
     A            LENVARFMTE     9B 0       TEXT('Length subst. var. element  ')
      *
     A            DATA        4096A         TEXT('Data                        ')
      *
      *                       CHAR(*)  Default reply
      *                       CHAR(*)  Message
      *                       CHAR(*)  Message help
      *                       CHAR(*)  Substitution variable formats
      *
