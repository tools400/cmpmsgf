      ***
      *
     A          R XDOBJD0100                TEXT('QUSROBJD API - OBJD0100')
      *
     A            BYTRET         9B 0       TEXT('Bytes Returned              ')
     A            BYTAVL         9B 0       TEXT('Bytes Available             ')
     A            NAME          10A         TEXT('Object Name                 ')
     A            LIB           10A         TEXT('Object Library Name         ')
     A            TYPE          10A         TEXT('Object Type                 ')
     A            RTNLIB        10A         TEXT('Return Library              ')
     A            AUXSTGP        9B 0       TEXT('Auxiliary storage pool      ')
     A            OWNER         10A         TEXT('Object Owner                ')
     A            DOMAIN         2A         TEXT('Object Domain               ')
     A            CRTDATTIM     13A         TEXT('Creation date and time      ')
     A            CHGDATTIM     13A         TEXT('Object change date and time ')
      *
